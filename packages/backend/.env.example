# --- Database ---
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Google Gemini (primary AI) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (fallback AI) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids from the Razorpay dashboard — required only once payments are
# enabled (PAYMENTS_ENABLED in billing.service.ts).
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=

# --- App ---
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
FREE_TRIAL_LIMIT=5

# --- Admin override ---
# Comma-separated list of Clerk-registered emails that get unlimited
# interview access without consuming free trials or requiring a paid
# subscription. Matched case-insensitively. Useful for founders / QA
# without having to run a manual UPDATE on the users.is_admin column.
# Example: ADMIN_EMAILS=founder@example.com,pm@example.com
ADMIN_EMAILS=
